# Environment variables for Lab Grader Web
# Copy this file to .env on your server and fill in the actual values
#
# IMPORTANT: Never commit .env to git!

# GitHub API token for accessing repositories
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, read:org, workflow
# (workflow: without it template updates that touch .github/workflows can't be
# sent to student forks - GitHub answers 404. Fine-grained token: Workflows read/write)
GITHUB_TOKEN=ghp_your_github_token_here

# Аварийный вход в админку (GitHub недоступен, OAuth App не настроен):
# даёт права суперадминистратора. Обычный вход - через GitHub, см. ниже.
ADMIN_LOGIN=your_admin_username
ADMIN_PASSWORD=your_secure_password_here

# GitHub-логины суперадминистраторов: доступ ко всем курсам в админке.
# Через запятую, без учёта регистра. Преподаватель курса получает доступ
# к своему курсу, если его GitHub-логин указан в course.github.teachers
# (docs/MULTI_TEACHER_PLAN.md).
SUPERADMIN_GITHUB_LOGINS=

# Secret key for cookie signing
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secret_key_here

# --- Хранилище конфигураций курсов (docs/COURSE_STORAGE_PLAN.md) ---
# local (по умолчанию) - каталог courses/ рядом с backend, для разработки;
# github - приватный репозиторий конфигураций, для сервера: каждое сохранение
# из админки - коммит с автором-преподавателем, история версий в админке.
COURSES_SOURCE=local
# Для COURSES_SOURCE=github:
# COURSES_GITHUB_REPO=markpolyak/lab_grader_courses
# COURSES_GITHUB_BRANCH=main
# Fine-grained токен: только этот репозиторий, Contents: Read and write
# COURSES_GITHUB_TOKEN=github_pat_...
# Как часто подхватывать коммиты, сделанные мимо админки (секунды)
# COURSES_REFRESH_SECONDS=30
# Снимок репозитория на диске - для старта при недоступном GitHub (volume)
# COURSES_CACHE_DIR=/app/courses-cache

# Google Sheets credentials file path (inside container)
CREDENTIALS_FILE=/app/google-credentials/credentials.json

# --- Вход через GitHub: студенты (/join/...) и преподаватели (админка) ---
# См. docs/REPO_GENERATION_PLAN.md и docs/MULTI_TEACHER_PLAN.md. Без них /join/*
# и /admin/login/github отвечают понятной ошибкой 503 вместо падения приложения,
# а в админку можно войти только аварийным входом (ADMIN_LOGIN/ADMIN_PASSWORD).

# OAuth App регистрируется ПРЕПОДАВАТЕЛЕМ на github.com:
# Settings -> Developer settings -> OAuth Apps -> New OAuth App
# Authorization callback URL должен быть <ваш-хост>/join/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Публичный URL frontend'а - куда перенаправляется браузер студента
# после прохождения OAuth (страница /join/:courseId/:labId)
FRONTEND_URL=http://localhost:8080

# Публичный адрес сервиса, из которого собирается секретная ссылка на
# получение репозитория (/j/{token}, см. docs/COURSE_CONFIG.md, секция join).
# За обратным прокси request.base_url содержит внутренний адрес контейнера,
# поэтому в продакшене эту переменную следует задать явно. Если не задана,
# используется FRONTEND_URL.
PUBLIC_BASE_URL=https://labgrader.example.ru

# Адреса обратного прокси, которым разрешено доверять заголовку
# X-Forwarded-For (см. docs/DEPLOYMENT.md). Пусто - не доверять никому:
# иначе ограничение частоты запросов обходится подделкой заголовка.
# Пример для Caddy в соседнем контейнере: FORWARDED_ALLOW_IPS=172.18.0.0/16
FORWARDED_ALLOW_IPS=

# Необязательно: явно задать Authorization callback URL, если backend работает
# за reverse-proxy и request.base_url не совпадает с адресом, зарегистрированным
# в OAuth App. По умолчанию вычисляется как "<адрес запроса>/join/callback"
# GITHUB_OAUTH_CALLBACK_URL=https://your-host/join/callback

# Optional: Branch to deploy (if using variable-based docker-compose.yaml)
# BRANCH=main
